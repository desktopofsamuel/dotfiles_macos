#!/usr/bin/env bash

set -e

CONFIG="install.conf.yaml"
DOTBOT_DIR="dotbot"

DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "${BASEDIR}"

# Prompt for development environment setup
echo ""
echo "=========================================="
echo "  Dotfiles Setup"
echo "=========================================="
echo ""
echo "Do you want to set up the development environment?"
echo "This includes:"
echo "  - Development tools (Node, Python, Ruby, etc.)"
echo "  - IDEs (VSCode, Cursor)"
echo "  - Development aliases and PATH configurations"
echo ""
read -p "Enable development setup? (y/N): " dev_setup_response

if [[ "$dev_setup_response" =~ ^[yY]$ ]]; then
    echo "Development setup: ENABLED"
    touch "$HOME/.dev_setup_enabled"
    export DEV_SETUP_ENABLED=1
else
    echo "Development setup: DISABLED"
    rm -f "$HOME/.dev_setup_enabled"
    export DEV_SETUP_ENABLED=0
fi
echo ""

git -C "${DOTBOT_DIR}" submodule sync --quiet --recursive
git submodule update --init --recursive "${DOTBOT_DIR}"

"${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIG}" "${@}"
